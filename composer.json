{
    "name": "tecclub/releasekit",
    "description": "Headless Laravel package for managing app releases, build artifacts, downloads, and version checks across platforms.",
    "keywords": [
        "tecclub",
        "laravel",
        "releasekit",
        "releases",
        "version-check",
        "app-updates",
        "downloads"
    ],
    "homepage": "https://github.com/TecClubb/laravel-releasekit",
    "license": "MIT",
    "authors": [
        {
            "name": "TecClub Technology SMC Private Limited",
            "email": "info@tecclubx.com",
            "homepage": "https://tecclubx.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "laravel/boost": "Lets AI agents in your project use ReleaseKit correctly through its bundled guideline and skill."
    },
    "autoload": {
        "psr-4": {
            "TecClub\\ReleaseKit\\": "src/",
            "TecClub\\ReleaseKit\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TecClub\\ReleaseKit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --exclude-group=large-files",
        "test-large": "vendor/bin/pest --group=large-files",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TecClub\\ReleaseKit\\ReleaseKitServiceProvider"
            ],
            "aliases": {
                "ReleaseKit": "TecClub\\ReleaseKit\\Facades\\ReleaseKit"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
